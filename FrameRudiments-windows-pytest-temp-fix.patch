new file mode 100644
--- /dev/null
+++ b/tests/conftest.py
@@ -0,0 +1,35 @@
+"""Keep Windows pytest runs away from stale per-user temp ACLs.
+
+A broken %TEMP%/pytest-of-<username> directory can cause hundreds of
+unrelated tmp_path fixtures to fail with WinError 5. Never delete or chmod
+that shared user directory: allocate a unique, owned base for each run.
+"""
+
+import os
+from pathlib import Path
+import tempfile
+
+
+def _assign_windows_basetemp(config, local_app_data):
+    """Set a fresh per-invocation base, unless the caller explicitly set one.
+
+    The chosen directory is *not* created here. pytest owns it and can remove
+    it safely when initializing its temp-path factory. Distinct UUID-like
+    names from mkdtemp prevent collisions between parallel pytest processes.
+    """
+    if config.getoption("basetemp", default=None):
+        return None
+    root = Path(local_app_data) / "FrameRudiments" / "pytest-tmp"
+    root.mkdir(parents=True, exist_ok=True)
+    # mkdtemp atomically reserves a name; pytest clears/recreates only this
+    # newly reserved subdirectory, never its parent or another process's run.
+    base = Path(tempfile.mkdtemp(prefix="run-", dir=root))
+    config.option.basetemp = str(base)
+    return base
+
+
+def pytest_configure(config):
+    if os.name == "nt":
+        local_app_data = os.environ.get("LOCALAPPDATA")
+        if local_app_data:
+            _assign_windows_basetemp(config, local_app_data)
diff --git a/tests/test_pytest_temp_isolation.py b/tests/test_pytest_temp_isolation.py
new file mode 100644
--- /dev/null
+++ b/tests/test_pytest_temp_isolation.py
@@ -0,0 +1,34 @@
+"""Validate per-run Windows pytest temp isolation on every CI platform."""
+
+from pathlib import Path
+from types import SimpleNamespace
+
+from conftest import _assign_windows_basetemp
+
+
+class _Config:
+    def __init__(self, basetemp=None):
+        self.option = SimpleNamespace(basetemp=basetemp)
+
+    def getoption(self, name, default=None):
+        return getattr(self.option, name, default)
+
+
+def test_windows_basetemp_is_unique_per_invocation(tmp_path):
+    first = _Config()
+    second = _Config()
+    a = _assign_windows_basetemp(first, tmp_path)
+    b = _assign_windows_basetemp(second, tmp_path)
+    root = tmp_path / "FrameRudiments" / "pytest-tmp"
+    assert a is not None and b is not None and a != b
+    assert a.parent == b.parent == root
+    assert Path(first.option.basetemp) == a
+    assert Path(second.option.basetemp) == b
+
+
+def test_explicit_pytest_basetemp_is_never_overridden(tmp_path):
+    explicit = str(tmp_path / "chosen-by-caller")
+    config = _Config(explicit)
+    assert _assign_windows_basetemp(config, tmp_path) is None
+    assert config.option.basetemp == explicit
+    assert not (tmp_path / "FrameRudiments").exists()
