include README.md LICENSE AGENTS.md RELEASE_NOTES.md analysis-releases.json
recursive-include docs *.md *.png *.svg *.json *.mp4
recursive-include tests *.py
include examples/isf-tint.fs
recursive-include examples gl-transition-*.glsl

recursive-include integration *.py *.mjs
recursive-include integration/fixtures *.json *.png *.md *.txt

# The cross-language graph qualifier exercises the real authoring source.
include authoring/package.json authoring/tsconfig.json authoring/index.html authoring/vite.config.ts
recursive-include authoring/src *.ts *.tsx *.css
recursive-include authoring/tests *.ts
recursive-include authoring/integration *.ts

prune models
prune visualiser-analysis

recursive-include scripts *.py *.ps1 *.sh
recursive-include src/framerudiments/sprite_assets *.png *.json
recursive-include src/framerudiments/fire_assets *.png *.json *.md
